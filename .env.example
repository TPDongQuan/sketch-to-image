# Copy this file to `.env` and adjust. All values below are the defaults used
# by the project; every variable is optional (see backend/config.py).

# Models (downloaded from the Hugging Face Hub on first run)
MODEL_ID=SG161222/Realistic_Vision_V5.1_noVAE
CONTROLNET_ID=lllyasviel/sd-controlnet-scribble
VAE_ID=stabilityai/sd-vae-ft-mse

# Generation defaults
IMG_SIZE=512
INFERENCE_STEPS=35
GUIDANCE_SCALE=9.0

# Story Mode settings -- see backend/config.py for the full validation notes.
USE_IP_ADAPTER=true
IP_ADAPTER_ID=h94/IP-Adapter
IP_ADAPTER_WEIGHT_NAME=ip-adapter_sd15.bin
IP_ADAPTER_SCALE=0.1
STORY_SAME_SEED=true
STORY_BASE_STRENGTH=0.90
